annina","lon":20.85,"lat":39.67,"from":1367,"to":1430},{"name":"Arta","lon":20.99,"lat":39.16,"from":1430,"to":1449},{"name":"Angelokastron (Angelokastro)","lon":21.3,"lat":38.58,"from":1449,"to":1460},{"name":"Vonitsa","lon":20.89,"lat":38.92,"from":1460,"to":1479}],"rulers":[{"name":"Michael I Komnenos Doukas","from":1205,"to":1214},{"name":"Theodore Komnenos Doukas","from":1215,"to":1230},{"name":"Michael II Komnenos Doukas","from":1230,"to":1268},{"name":"Nikephoros I Komnenos Doukas","from":1268,"to":1297},{"name":"Thomas I Komnenos Doukas","from":1297,"to":1318},{"name":"Nicholas Orsini","from":1318,"to":1323},{"name":"John II Orsini","from":1323,"to":1335},{"name":"Nikephoros II Orsini","from":1335,"to":1340},{"name":"Nikephoros II Orsini (restored)","from":1356,"to":1359},{"name":"Simeon Uros","from":1359,"to":1366,"title":"Serbian emperor at Trikala, nominal lord of Epirus"},{"name":"Thomas II Preljubovic","from":1367,"to":1384,"title":"Despot at Ioannina"},{"name":"Maria Angelina Doukaina Palaiologina","from":1384,"to":1385,"title":"Despoina"},{"name":"Esau de' Buondelmonti","from":1385,"to":1411},{"name":"Carlo I Tocco","from":1411,"to":1429},{"name":"Carlo II Tocco","from":1429,"to":1448},{"name":"Leonardo III Tocco","from":1448,"to":1479}],"area":[[1205,162],[1210,164],[1212,191],[1213,194],[1214,195],[1216,233],[1217,239],[1218,241],[1220,268],[1221,278],[1222,281],[1224,333],[1225,341],[1226,416],[1227,164],[1230,141],[1236,143],[1241,175],[1246,208],[1250,194],[1252,185],[1256,180],[1268,122],[1272,95],[1279,62],[1294,60],[1304,62],[1307,60],[1318,41],[1319,38],[1325,61],[1326,56],[1332,65],[1336,28],[1337,22],[1339,28],[1340,21],[1356,102],[1359,0],[1367,41],[1375,40],[1380,43],[1385,41],[1411,49],[1415,46],[1416,74],[1422,76],[1430,52],[1431,34],[1449,6],[1459,5],[1460,4],[1463,3],[1479,0]],"ledger":[{"y":1205,"t":"found","x":"1205: Michael Komnenos Doukas sets up at Arta.","cp":"byzantine-empire","cpn":"Byzantine Empire","u":"https://en.wikipedia.