dia.org/wiki/Ecuadorian%E2%80%93Peruvian_War","c":1}],"wars":[{"name":"Gran Colombia-Peru War","from":1828,"to":1829,"outcome":"Stalemate after Tarqui; the Armistice of Piura (10 July 1829) recognised Tumbes, Jaen and Maynas as Peruvian and Guayaquil as Gran Colombian; the Larrea-Gual Treaty (22 September 1829) restored the status quo ante bellum.","u":"https://en.wikipedia.org/wiki/Gran_Colombia%E2%80%93Peru_War"},{"name":"War of the Confederation","from":1836,"to":1839,"outcome":"Yungay (20 January 1839) dissolved the Confederation; Peru was restored.","u":"https://en.wikipedia.org/wiki/Peru%E2%80%93Bolivian_Confederation"},{"name":"Chincha Islands War","from":1864,"to":1866,"outcome":"Spain withdrew after the battle of Callao on 2 May 1866.","u":"https://en.wikipedia.org/wiki/Peru"},{"name":"War of the Pacific","from":1879,"to":1884,"outcome":"Chilean victory: Peru ceded Tarapaca by the Treaty of Ancon (20 October 1883) and Tacna and Arica passed to ten years of Chilean control; the plebiscite never took place and the Treaty of Lima (3 June 1929) gave Tacna to Peru and Arica to Chile.","u":"https://en.wikipedia.org/wiki/War_of_the_Pacific"},{"name":"Colombia-Peru War","from":1932,"to":1933,"outcome":"Status quo ante bellum: Leticia stayed Colombian; the Rio de Janeiro Protocol of 1934 reaffirmed the Salomon-Lozano Treaty.","u":"https://en.wikipedia.org/wiki/Colombia%E2%80%93Peru_War"},{"name":"Ecuadorian-Peruvian War","from":1941,"to":1942,"outcome":"Peruvian victory; the Rio de Janeiro Protocol of 29 January 1942 followed; Peru left El Oro on 12 February 1942.","u":"https://en.wikipedia.org/wiki/Ecuadorian%E2%80%93Peruvian_War"},{"name":"Cenepa War","from":1995,"to":1995,"outcome":"The border dispute 'not entirely resolved until the Cenepa War of 1995'; the Brasilia Presidential Act of 26 October 1998 was the 'definitive peace agreement'.","u":"https://en.wikipedia.org/wiki/Ecuadorian%E2%80%93Peruvian_War"}],"certainty":[{"from":1821,"to":1883,"level":"soft","no