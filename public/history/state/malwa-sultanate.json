{"slug":"malwa-sultanate","name":"Malwa Sultanate","native":[],"alt":["Sultanate of Malwa","Kingdom of Malwa","Khalji sultanate of Malwa"],"type":"state","family":"india","start":{"year":1401},"end":{"year":1562},"wikipedia":"Malwa Sultanate","wikidata":null,"colour":"#819ae9","fb":0,"first":1401,"last":1560,"peak":611,"peakYear":1457,"predecessors":[{"slug":"tughlaq-dynasty","name":"Tughlaq dynasty","year":null,"text":"Malwa, governed by Dilawar Khan for the Tughlaqs"}],"successors":[{"slug":"mughal-empire","name":"Mughal Empire","year":null,"text":"Malwa, the Mughal Malwa Subah with its seat at Ujjain"}],"capitals":[{"name":"Dhar","lon":75.3,"lat":22.6,"from":1401,"to":1409},{"name":"Mandu (Shadiabad)","lon":75.4,"lat":22.36,"from":1410,"to":1531},{"name":"Mandu","lon":75.4,"lat":22.36,"from":1555,"to":1562}],"rulers":[{"name":"Dilawar Khan","from":1401,"to":1406},{"name":"Alp Khan (Hoshang Shah)","from":1406,"to":1407},{"name":"Hoshang Shah (restored)","from":1409,"to":1435},{"name":"Mahmud Shah I (Mahmud Khalji)","from":1436,"to":1469},{"name":"Ghiyas-ud-Din Shah","from":1469,"to":1510},{"name":"Nasir-ud-Din Shah","from":1510,"to":1510},{"name":"Mahmud Shah II","from":1511,"to":1531},{"name":"Qadir Shah","from":1537,"to":1542},{"name":"Baz Bahadur","from":1555,"to":1562}],"area":[[1401,556],[1457,611],[1468,603],[1529,549],[1531,4],[1534,0],[1537,109],[1542,31],[1555,556],[1561,0]],"ledger":[{"y":1401,"t":"found","x":"1401: Dilawar Khan makes Malwa an independent realm at Dhar.","cp":"tughlaq-dynasty","cpn":"Tughlaq dynasty","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate","c":2},{"y":1407,"t":"occupation_start","x":"1407: Gujarat takes Dhar.","cp":"gujarat-sultanate","cpn":"Gujarat Sultanate","u":"https://en.wikipedia.org/wiki/Hoshang_Shah","c":2},{"y":1409,"t":"occupation_end","x":"1409: Hoshang Shah is back in Malwa.","cp":"gujarat-sultanate","cpn":"Gujarat Sultanate","u":"https://en.wikipedia.org/wiki/Hoshang_Shah","c":2},{"y":1410,"t":"capital_move","x":"1410: the capital moves from Dhar to Mandu.","u":"https://en.wikipedia.org/wiki/Hoshang_Shah","c":1},{"y":1420,"t":"contest_start","x":"1420: Hoshang's war on Kherla begins.","cp":"Kherla","u":"https://en.wikipedia.org/wiki/Hoshang_Shah","c":2},{"y":1433,"t":"contest_end","x":"1433: the conquest of Kherla ends.","cp":"Kherla","u":"https://en.wikipedia.org/wiki/Hoshang_Shah","c":2},{"y":1433,"t":"gain","x":"1433: Kherla is Malwa's.","cp":"Kherla","u":"https://en.wikipedia.org/wiki/Hoshang_Shah","c":2},{"y":1436,"t":"rename","x":"1436: the Khalji dynasty replaces the Ghurids.","m":5,"u":"https://en.wikipedia.org/wiki/Mahmud_Khalji","c":3},{"y":1444,"t":"gain","x":"1444: Gagron falls to Mahmud.","m":2,"cp":"Gagron","u":"https://en.wikipedia.org/wiki/Mahmud_Khalji","c":2},{"y":1457,"t":"gain","x":"1457 (bridging): Mahmud takes Ajmer.","cp":"kingdom-of-mewar","cpn":"Kingdom of Mewar","u":"https://en.wikipedia.org/wiki/Mahmud_Khalji","c":1},{"y":1457,"t":"gain","x":"1457: Mahmud takes Mandalgarh.","m":10,"cp":"kingdom-of-mewar","cpn":"Kingdom of Mewar","u":"https://en.wikipedia.org/wiki/Mahmud_Khalji","c":2},{"y":1519,"t":"contest_start","x":"1519: Rana Sanga overruns Malwa.","cp":"kingdom-of-mewar","cpn":"Kingdom of Mewar","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate","c":2},{"y":1528,"t":"contest_end","x":"1528: Medini Rai falls at Chanderi.","cp":"kingdom-of-mewar","cpn":"Kingdom of Mewar","u":"https://en.wikipedia.org/wiki/Medini_Rai","c":1},{"y":1531,"t":"loss","x":"1531 (bridging): Ajmer leaves the Malwa shape.","cp":"Gujarat Sultanate (Ajmer), then Biram Dev of Merta","u":"https://en.wikipedia.org/wiki/Maldeo_Rathore","c":1},{"y":1531,"t":"loss","x":"1531: Mandu falls and Gujarat annexes Malwa.","m":3,"cp":"gujarat-sultanate","cpn":"Gujarat Sultanate","u":"https://en.wikipedia.org/wiki/Bahadur_Shah_of_Gujarat","c":3},{"y":1537,"t":"gain","x":"1537: Qadir Shah regains part of the kingdom.","cp":"gujarat-sultanate","cpn":"Gujarat Sultanate","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate","c":2},{"y":1542,"t":"loss","x":"1542: Sher Shah Suri conquers Malwa.","cp":"sur-empire","cpn":"Sur Empire","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate","c":3},{"y":1555,"t":"gain","x":"1555: Baz Bahadur declares himself independent.","cp":"sur-empire","cpn":"Sur Empire","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate","c":2},{"y":1561,"t":"contest_start","x":"1561: the Mughals invade Malwa.","m":3,"cp":"mughal-empire","cpn":"Mughal Empire","u":"https://en.wikipedia.org/wiki/Baz_Bahadur","c":3},{"y":1562,"t":"contest_end","x":"1562: the Mughals win Malwa.","cp":"mughal-empire","cpn":"Mughal Empire","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate","c":3},{"y":1562,"t":"dissolve","x":"1562: the Malwa Sultanate becomes the Mughal Malwa Subah.","cp":"mughal-empire","cpn":"Mughal Empire","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate","c":3}],"wars":[{"name":"Gujarat-Malwa wars","from":1407,"to":1531,"outcome":"Gujarat held Dhar in 1407-1409, raided Malwa in 1419, 1420, 1422 and 1438 and annexed it in 1531; Malwa and Khandesh's attack on Gujarat in 1417 failed.","u":"https://en.wikipedia.org/wiki/Gujarat_Sultanate"},{"name":"Conquest of Kherla","from":1420,"to":1433,"outcome":"Kherla was conquered and became part of Malwa.","u":"https://en.wikipedia.org/wiki/Hoshang_Shah"},{"name":"Malwa invasion of Orissa","from":1422,"to":1422,"outcome":"A raid; the Hoshang Shah page gives only 'Invasion of Orissa (1422)' and no land changed hands.","u":"https://en.wikipedia.org/wiki/Hoshang_Shah"},{"name":"Siege of Gagron (1423)","from":1423,"to":1423,"outcome":"The infobox lists the siege; the fort is taken by Mahmud Khalji in 1444.","u":"https://en.wikipedia.org/wiki/Hoshang_Shah"},{"name":"Kalpi War","from":1432,"to":1433,"outcome":"The infobox lists the war; the page says Kalpi's suzerainty came through a marriage alliance and gives no territory or year for it.","u":"https://en.wikipedia.org/wiki/Hoshang_Shah"},{"name":"Malwa-Mewar wars","from":1437,"to":1457,"outcome":"Rana Kumbha defeated and captured Mahmud Khalji at Mandavgad in 1437; battles followed in 1442-1446; Mahmud took Mandalgarh in October 1457.","u":"https://en.wikipedia.org/wiki/Mahmud_Khalji"},{"name":"Battle of Gagron (1519)","from":1519,"to":1519,"outcome":"Rana Sanga defeated Mahmud Shah II of Malwa (and the Gujarat contingent) and put Medini Rai over much of Malwa.","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate"},{"name":"Gujarat's conquest of Malwa","from":1531,"to":1531,"outcome":"Mandu fell to Bahadur Shah on 28 March 1531; Malwa was annexed to Gujarat.","u":"https://en.wikipedia.org/wiki/Bahadur_Shah_of_Gujarat"},{"name":"Sur conquest of Malwa","from":1542,"to":1542,"outcome":"Sher Shah Suri defeated Qadir Shah in 1542 and appointed Shuja'at Khan governor.","u":"https://en.wikipedia.org/wiki/Malwa_Sultanate"},{"name":"Mughal conquest of Malwa","from":1561,"to":1562,"outcome":"Baz Bahadur lost at Sarangpur on 29 March 1561, regained Malwa with a Khandesh-Berar coalition, and was finally defeated by Abdullah Khan in 1562.","u":"https://en.wikipedia.org/wiki/Baz_Bahadur"}],"certainty":[{"from":1401,"to":1562,"level":"soft","note":"No treaty line is given on any page opened; the Rajasthan frontier with Mewar (Gagron, Mandalgarh) and the Gondwana frontier at Kherla are approximate."}],"sources":[{"url":"https://en.wikipedia.org/wiki/Malwa_Sultanate","title":"Malwa Sultanate"},{"url":"https://en.wikipedia.org/wiki/Hoshang_Shah","title":"Hoshang Shah"},{"url":"https://en.wikipedia.org/wiki/Mahmud_Khalji","title":"Mahmud Khalji"},{"url":"https://en.wikipedia.org/wiki/Medini_Rai","title":"Medini Rai"},{"url":"https://en.wikipedia.org/wiki/Baz_Bahadur","title":"Baz Bahadur"},{"url":"https://en.wikipedia.org/wiki/Gujarat_Sultanate","title":"Gujarat Sultanate"},{"url":"https://en.wikipedia.org/wiki/Bahadur_Shah_of_Gujarat","title":"Bahadur Shah of Gujarat"},{"url":"https://en.wikipedia.org/wiki/Maldeo_Rathore","title":"Maldeo Rathore"}]}