ki/Turk_Shahi"},{"name":"Saffarid conquest of Kabul","from":870,"to":870,"outcome":"Ya'qub ibn al-Layth marched onto Kabul in 870; the Saffarids held the region to 878 until Lalliya recaptured it.","u":"https://en.wikipedia.org/wiki/Hindu_Shahis"}],"certainty":[{"from":665,"to":870,"level":"soft","note":"No treaty line is drawn on any page opened; the Hindu Kush and the Kabul valley are the only named frontier lands."}],"sources":[{"url":"https://en.wikipedia.org/wiki/Kabul_Shahi","title":"Kabul Shahi"},{"url":"https://en.wikipedia.org/wiki/Turk_Shahi","title":"Turk Shahi"},{"url":"https://en.wikipedia.org/wiki/Zunbils","title":"Zunbils"},{"url":"https://en.wikipedia.org/wiki/Hindu_Shahis","title":"Hindu Shahis"},{"url":"https://en.wikipedia.org/wiki/Nezak_Huns","title":"Nezak Huns"}]}