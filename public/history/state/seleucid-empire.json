edia.org/wiki/Antiochus_III_the_Great","c":2},{"y":-219,"t":"contest_start","x":"219: the Fourth Syrian War begins.","cp":"ptolemaic-kingdom","cpn":"Ptolemaic Kingdom","u":"https://en.wikipedia.org/wiki/Syrian_Wars","c":3},{"y":-219,"t":"gain","x":"219: Antiochus III retakes Seleucia Pieria and the Phoenician coast.","cp":"ptolemaic-kingdom","cpn":"Ptolemaic Kingdom","u":"https://en.wikipedia.org/wiki/Syrian_Wars","c":2},{"y":-217,"t":"contest_end","x":"217: Raphia ends the Fourth Syrian War.","cp":"ptolemaic-kingdom","cpn":"Ptolemaic Kingdom","u":"https://en.wikipedia.org/wiki/Syrian_Wars","c":3},{"y":-217,"t":"loss","x":"217: Ptolemy IV keeps Coele-Syria.","cp":"ptolemaic-kingdom","cpn":"Ptolemaic Kingdom","u":"https://en.wikipedia.org/wiki/Syrian_Wars","c":2},{"y":-216,"t":"contest_start","x":"216: Antiochus marches against Achaeus.","cp":"kingdom-of-achaeus","cpn":"Kingdom of Achaeus","u":"https://en.wikipedia.org/wiki/Antiochus_III_the_Great","c":3},{"y":-214,"t":"gain","x":"214: Antiochus drives Achaeus into Sardis.","cp":"kingdom-of-achaeus","cpn":"Kingdom of Achaeus","u":"https://en.wikipedia.org/wiki/Antiochus_III_the_Great","c":2},{"y":-213,"t":"contest_end","x":"213: the fighting for Sardis ends.","cp":"kingdom-of-achaeus","cpn":"Kingdom of Achaeus","u":"https://en.wikipedia.org/wiki/Antiochus_III_the_Great","c":3},{"y":-213,"t":"gain","x":"213: Sardis falls and Achaeus's rule ends.","cp":"kingdom-of-achaeus","cpn":"Kingdom of Achaeus","u":"https://en.wikipedia.org/wiki/Antiochus_III_the_Great","c":3},{"y":-212,"t":"vassal_start","x":"212: Armenia becomes a Seleucid vassal.","cp":"kingdom-of-armenia","cpn":"Kingdom of Armenia","u":"https://en.wikipedia.org/wiki/Antiochus_III_the_Great","c":2},{"y":-209,"t":"vassal_start","x":"209: Parthia submits to Antiochus III.","cp":"parthian-empire","cpn":"Parthian Empire","u":"https://en.wikipedia.org/wiki/Antiochus_III_the_Great","c":2},{"y":-209,"t":"vassal_start","x":"209: Bactria makes peace with Antiochus III."