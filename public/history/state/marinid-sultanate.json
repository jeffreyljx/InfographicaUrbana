2},{"y":1294,"t":"gain","x":"By 1294: the Marinids hold Rota, Tarifa and Gibraltar.","cp":"crown-of-castile","cpn":"Crown of Castile","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":2},{"y":1299,"t":"contest_start","x":"1299: the Marinids besiege Tlemcen.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":3},{"y":1306,"t":"gain","x":"1306: Taroudannt is conquered and destroyed.","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":3},{"y":1307,"t":"contest_end","x":"1307: the siege of Tlemcen ends without conquest.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Zayyanid_dynasty","c":3},{"y":1309,"t":"gain","x":"1309: Abu al-Rabi Sulayman enters Ceuta.","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":3},{"y":1329,"t":"gain","x":"1329: the Marinids beat the Castilians at Algeciras.","cp":"crown-of-castile","cpn":"Crown of Castile","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":2},{"y":1333,"t":"gain","x":"17 June 1333: Gibraltar surrenders to the Marinids.","m":6,"cp":"crown-of-castile","cpn":"Crown of Castile","u":"https://en.wikipedia.org/wiki/Abu_al-Hasan_Ali_ibn_Othman","c":3},{"y":1337,"t":"occupation_start","x":"May 1337: Abu al-Hasan takes Tlemcen.","m":5,"cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Abu_al-Hasan_Ali_ibn_Othman","c":2},{"y":1344,"t":"loss","x":"1344: the Marinids are 'definitively ejected from Iberia'.","cp":"crown-of-castile","cpn":"Crown of Castile","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":2},{"y":1344,"t":"loss","x":"March 1344: Castile takes Algeciras.","m":3,"cp":"crown-of-castile","cpn":"Crown of Castile","u":"https://en.wikipedia.org/wiki/Abu_al-Hasan_Ali_ibn_Othman","c":3},{"y":1347,"t":"occupation_start","x":"September 1347: Abu al-Hasan enters Tunis.","m":9,"cp":"hafsid-dynasty","cpn":"Hafsid dynasty","u":"https://en.wikipedia.org/wiki/Abu_al-Hasan_Ali_ibn_Othman","c":3},{"y":1348,"t":"occupation_end","x":"1348: Tlemcen is lost to the Zayyanids.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Zayyanid_dynasty","c":3},{"y":1349,"t":"occupation_end","x":"1349: Abu al-Hasan leaves Ifriqiya.","cp":"hafsid-dynasty","cpn":"Hafsid dynasty","u":"https://en.wikipedia.org/wiki/Hafsid_dynasty","c":3},{"y":1352,"t":"occupation_start","x":"1352: Abu Inan retakes Tlemcen.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Abu_Inan_Faris","c":3},{"y":1353,"t":"occupation_start","x":"1353: Abu Inan takes Bejaia.","cp":"hafsid-dynasty","cpn":"Hafsid dynasty","u":"https://en.wikipedia.org/wiki/Abu_Inan_Faris","c":3},{"y":1357,"t":"occupation_start","x":"August 1357: Abu Inan takes Tunis.","cp":"hafsid-dynasty","cpn":"Hafsid dynasty","u":"https://en.wikipedia.org/wiki/Hafsid_dynasty","c":3},{"y":1357,"t":"occupation_end","x":"1357: Abu Inan retreats from Tunisia.","cp":"hafsid-dynasty","cpn":"Hafsid dynasty","u":"https://en.wikipedia.org/wiki/Abu_Inan_Faris","c":3},{"y":1358,"t":"occupation_end","x":"1358: Marinid Bejaia, bridging.","cp":"hafsid-dynasty","cpn":"Hafsid dynasty","u":"https://en.wikipedia.org/wiki/Abu_Inan_Faris","c":1},{"y":1359,"t":"occupation_end","x":"1359: the Zayyanids are restored.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Zayyanid_dynasty","c":3},{"y":1370,"t":"occupation_start","x":"1370: third seizure of Tlemcen.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":3},{"y":1372,"t":"occupation_end","x":"1372: Tlemcen is Zayyanid again, bridging.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Zayyanid_dynasty","c":1},{"y":1374,"t":"split","x":"1374: the sultanate is partitioned.","cp":"Marinid Kingdom of Marrakesh","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":3},{"y":1387,"t":"merge","x":"1387: the Kingdom of Marrakesh ends.","cp":"Marinid Kingdom of Marrakesh","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":2},{"y":1387,"t":"occupation_start","x":"1387: Abu al-Abbas reconquers Tlemcen and Algiers.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":3},{"y":1389,"t":"occupation_end","x":"1389: Zayyanid rule again, bridging.","cp":"zayyanid-dynasty","cpn":"Zayyanid dynasty","u":"https://en.wikipedia.org/wiki/Zayyanid_dynasty","c":1},{"y":1415,"t":"loss","x":"21 August 1415: Portugal takes Ceuta.","m":8,"cp":"kingdom-of-portugal","cpn":"Kingdom of Portugal","u":"https://en.wikipedia.org/wiki/Conquest_of_Ceuta","c":3},{"y":1458,"t":"loss","x":"1458: Portugal takes Ksar es-Seghir.","cp":"kingdom-of-portugal","cpn":"Kingdom of Portugal","u":"https://en.wikipedia.org/wiki/Conquest_of_Ceuta","c":2},{"y":1465,"t":"loss","x":"1465: Afonso V takes Tangier.","cp":"kingdom-of-portugal","cpn":"Kingdom of Portugal","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate","c":2},{"y":1465,"t":"dissolve","x":"1465: a revolt in Fez kills the last Marinid sultan.","cp":"wattasid-dynasty","cpn":"Wattasid dynasty","u":"https://en.wikipedia.org/wiki/Wattasid_dynasty","c":3}],"wars":[{"name":"Marinid conquest of Morocco","from":1244,"to":1269,"outcome":"Marinid victory: Meknes 1244 or 1245, Taza, Rabat and Sale by 1248, Fez 1248, Sijilmassa 1255, Marrakesh 1269.","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate"},{"name":"Marinid siege of Tlemcen","from":1299,"to":1307,"outcome":"Indecisive: the siege of eight or nine years ends in 1307 without a conquest.","u":"https://en.wikipedia.org/wiki/Zayyanid_dynasty"},{"name":"Marinid campaigns in Iberia","from":1286,"to":1344,"outcome":"Marinid footholds (Rota, Tarifa and Gibraltar by 1294; Algeciras from 1329; Gibraltar retaken 17 June 1333) end with the defeat at Rio Salado (October 1340) and the fall of Algeciras (March 1344).","u":"https://en.wikipedia.org/wiki/Abu_al-Hasan_Ali_ibn_Othman"},{"name":"Marinid conquest of Tlemcen","from":1335,"to":1337,"outcome":"Marinid victory: invasion early 1335, siege broken off 1336 or 1337, Tlemcen falls in May 1337.","u":"https://en.wikipedia.org/wiki/Abu_al-Hasan_Ali_ibn_Othman"},{"name":"Marinid invasion of Ifriqiya","from":1347,"to":1349,"outcome":"Initial victory (Tunis, September 1347), then defeat by the Arab tribes near Kairouan (April 1348) and withdrawal in 1349.","u":"https://en.wikipedia.org/wiki/Abu_al-Hasan_Ali_ibn_Othman"},{"name":"Abu Inan's campaigns","from":1352,"to":1358,"outcome":"Tlemcen 1352, Bejaia 1353, Tunis August 1357, all lost with his death on 10 January 1358.","u":"https://en.wikipedia.org/wiki/Abu_Inan_Faris"},{"name":"Portuguese conquest of Ceuta","from":1415,"to":1419,"outcome":"Portuguese victory on 21 August 1415; the Marinid siege of 1419 (1418 in the Marinid chronology) fails.","u":"https://en.wikipedia.org/wiki/Conquest_of_Ceuta"},{"name":"Portuguese expeditions against Tangier and Ksar es-Seghir","from":1437,"to":1465,"outcome":"The 1437 expedition to Tangier fails; Ksar es-Seghir falls in 1458 and Tangier in 1465 (Conquest of Ceuta page: 1471).","u":"https://en.wikipedia.org/wiki/Marinid_Sultanate"}],"certainty":[{"from":1244,"to":1465,"level":"soft","note":"No treaty line is given for any Marinid frontier: the Moulouya frontier with Tlemcen, the Saharan edge and the Atlas are approximate; the peace of Fez in February 1334 between Castile, Granada and Morocco is a truce, not a line."}],"sources":[{"url":"https://en.wikipedia.org/wiki/Marinid_Sultanate","title":"Marinid Sultanate"},{"url":"https://en.wikipedia.org/wiki/Abu_al-Hasan_Ali_ibn_Othman","title":"Abu al-Hasan Ali ibn Othman"},{"url":"https://en.wikipedia.org/wiki/Abu_Inan_Faris","title":"Abu Inan Faris"},{"url":"https://en.wikipedia.org/wiki/Hafsid_dynasty","title":"Hafsid dynasty"},{"url":"https://en.wikipedia.org/wiki/Zayyanid_dynasty","title":"Zayyanid dynasty"},{"url":"https://en.wikipedia.org/wiki/Conquest_of_Ceuta","title":"Conquest of Ceuta"},{"url":"https://en.wikipedia.org/wiki/Wattasid_dynasty","title":"Wattasid dynasty"}]}