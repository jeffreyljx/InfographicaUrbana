:[{"name":"Barradas expedition (Spanish reconquest attempt)","from":1829,"to":1829,"outcome":"The Spanish landing at Tampico failed: the troops 'succumbed to yellow fever and were defeated'.","u":"https://en.wikipedia.org/wiki/First_Mexican_Republic"},{"name":"Texas Revolution","from":1835,"to":1836,"outcome":"Texian victory: San Jacinto (21 April 1836); Santa Anna signed the Treaty of Velasco; Mexico 'refused to recognize the Republic of Texas'.","u":"https://en.wikipedia.org/wiki/Texas_Revolution"},{"name":"Pastry War","from":1838,"to":1839,"outcome":"French bombardment of Veracruz on 27 November 1838; no territory changed hands.","u":"https://en.wikipedia.org/wiki/Centralist_Republic_of_Mexico"},{"name":"Federalist rebellion of the Republic of the Rio Grande","from":1840,"to":1840,"outcome":"The rebellion ended with Antonio Canales's surrender at Camargo on 6 November 1840; the Centralist government won.","u":"https://en.wikipedia.org/wiki/Republic_of_the_Rio_Grande"},{"name":"Mexican-American War","from":1846,"to":1848,"outcome":"American victory: the Treaty of Guadalupe Hidalgo (signed 2 February 1848, ratifications exchanged 30 May 1848) gave the United States Alta California and Santa Fe de Nuevo Mexico, and Mexico recognised the Rio Grande as the southern boundary of Texas.","u":"https://en.wikipedia.org/wiki/Mexican%E2%80%93American_War"},{"name":"Walker's Baja California filibuster","from":1853,"to":1854,"outcome":"The 'Republic of Baja California' proclaimed on 3 November 1853 was disestablished on 21 January 1854; Walker surrendered at San Diego.","u":"https://en.wikipedia.org/wiki/Republic_of_Baja_California"},{"name":"Second French intervention in Mexico","from":1861,"to":1867,"outcome":"Mexican victory: the French left in 1867, Maximilian was executed on 19 June 1867 and the Republic was restored.","u":"https://en.wikipedia.org/wiki/Second_French_intervention_in_Mexico"}],"certainty":[{"from":1823,"to":1835,"level":"soft","note":"The northern frontier (Alta California, Santa Fe de Nuevo Mexico, Texas) is the Adams-Onis line the Treaty of Guadalupe Hidalgo page names, drawn approximately; the Soconusco boundary with Central America was disputed."},{"from":1836,"to":1847,"level":"soft","note":"The Texas boundary (Nueces or Rio Grande) was disputed until 1848."},{"from":1848,"to":1867,"level":"sharp","note":"The Rio Grande, Gila and California boundary of the Treaty of Guadalupe Hidalgo (1848) and the Gadsden line (1853-1854) are treaty lines; the intervention years (1861-1867) are fronts, not borders."}],"sources":[{"url":"https://en.wikipedia.org/wiki/First_Mexican_Republic","title":"First Mexican Republic"},{"url":"https://en.wikipedia.org/wiki/Centralist_Republic_of_Mexico","title":"Centralist Republic of Mexico"},{"url":"https://en.wikipedia.org/wiki/Texas_Revolution","title":"Texas Revolution"},{"url":"https://en.wikipedia.org/wiki/Mexican%E2%80%93American_War","title":"Mexican-American War"},{"url":"https://en.wikipedia.org/wiki/Treaty_of_Guadalupe_Hidalgo","title":"Treaty of Guadalupe Hidalgo"},{"url":"https://en.wikipedia.org/wiki/Gadsden_Purchase","title":"Gadsden Purchase"},{"url":"https://en.wikipedia.org/wiki/Republic_of_the_Rio_Grande","title":"Republic of the Rio Grande"},{"url":"https://en.wikipedia.org/wiki/Republic_of_Baja_California","title":"Republic of Baja California"},{"url":"https://en.wikipedia.org/wiki/Second_French_intervention_in_Mexico","title":"Second French intervention in Mexico"},{"url":"https://en.wikipedia.org/wiki/Second_Mexican_Empire","title":"Second Mexican Empire"},{"url":"https://en.wikipedia.org/wiki/Soconusco","title":"Soconusco"}]}