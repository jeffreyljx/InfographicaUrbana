From 90ee87e0ad5d47f59ce524b7cb7fe494c7e8745a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 17:19:50 +0000
Subject: [PATCH] Display skyline extent: join skylines that almost touch

Outline pieces of a city join when one can be reached from the other in
steps of at most 1.9 km between 150 m+ towers and outline edges, with no
step crossing more than 600 m of water (Shekou, Nanshan and Qianhai;
Tianhe and Pazhou; Shenzhen Bay and Xiangmihu). 37 cities change.
public/skyline-extent.geojson is skyline-extent/skyline-extent-joined.geojson
(md5 811f2e119a43eb23747d472d4300a9bf), built by tools/build_joined.py.

The deploy bootstrap also unpacks bundle/delta2.tar.br.partNN after the
delta tar, so a change can ship without rebuilding the delta.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QEw7jWCRyhcdfinpRjVmuQ
---
 deploy/bootstrap.mjs          | 7 ++++---
 public/skyline-extent.geojson | 2 +-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/deploy/bootstrap.mjs b/deploy/bootstrap.mjs
index 79e830f..52dd452 100644
--- a/deploy/bootstrap.mjs
+++ b/deploy/bootstrap.mjs
@@ -6,9 +6,9 @@ import { readdirSync, readFileSync, writeFileSync, existsSync, rmSync, cpSync }
 import { brotliDecompressSync } from "node:zlib";
 import { execSync } from "node:child_process";
 
-// bundle/overlay.tar.br.partNN and bundle/delta.tar.br.partNN, if present, are further brotli tars unpacked over
-// the tree in that order (earlier fixes, then the latest change), so a change can ship as a small upload
-// without rebuilding the whole bundle.
+// bundle/overlay.tar.br.partNN, bundle/delta.tar.br.partNN and bundle/delta2.tar.br.partNN, if present, are further
+// brotli tars unpacked over the tree in that order (earlier fixes, then the latest changes), so a change can ship as a
+// small upload without rebuilding the whole bundle.
 function unpack(name, what) {
   const parts = readdirSync("bundle").filter(f => f.startsWith(`${name}.tar.br.part`)).sort();
   if (!parts.length) return;
@@ -22,6 +22,7 @@ if (existsSync("bundle")) {
   unpack("src", "source tree");
   unpack("overlay", "earlier fixes");
   unpack("delta", "changes since the bundle");
+  unpack("delta2", "changes since the delta");
 }
 // plain overlay/ files go last, so a small change can ship on top of the tars above
 if (existsSync("overlay")) {
diff --git a/public/skyline-extent.geojson b/public/skyline-extent.geojson
index 6635ac5..535f04e 100644
